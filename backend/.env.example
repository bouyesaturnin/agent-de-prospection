VITE_API_URL=http://127.0.0.1:8000/api
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Envoi d'emails via Brevo — clé API : https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Adresse d'expéditeur : doit être un domaine/email validé dans Brevo (Expéditeurs & IP)
BREVO_SENDER_EMAIL=contact@tondomaine.com
BREVO_SENDER_NAME=Agent de Prospection

# Détection des réponses (relevé IMAP périodique) — utilise de préférence un
# mot de passe d'application dédié plutôt que ton mot de passe principal.
IMAP_HOST=imap.tonfournisseur.com
IMAP_PORT=993
IMAP_USERNAME=contact@tondomaine.com
IMAP_PASSWORD=xxxxxxxxxxxxxxxx
# IMAP_MAILBOX=INBOX

# Optionnel — valeurs par défaut déjà correctes en développement
# DJANGO_SECRET_KEY=
# DJANGO_DEBUG=True
# DJANGO_ALLOWED_HOSTS=
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0
# PUBLIC_BACKEND_URL=http://127.0.0.1:8000

